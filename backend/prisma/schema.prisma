generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("READ_ONLY")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AutomationModule {
  id              String       @id @default(cuid())
  name            String       @unique
  displayName     String
  description     String?
  repoPath        String
  jenkinsJobName  String?
  platform        String
  framework       String
  environment     String       @default("staging")
  testCommands    String
  browserSupport  String?
  tags            String?
  color           String?      @default("#3b82f6")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  executions      Execution[]
  schedules       Schedule[]
  testCases       TestCase[]
}

model TestCase {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  filePath        String
  framework       String
  tags            String?
  testIdentifier  String?
  isActive        Boolean          @default(true)
  lastSyncedAt    DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  module          AutomationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, filePath, title])
  @@index([moduleId])
  @@index([isActive])
}

model Execution {
  id                String             @id @default(cuid())
  moduleId          String
  jenkinsBuildNumber Int?
  jenkinsBuildUrl   String?
  jenkinsJobName    String?
  queueItemId       Int?
  testCommand       String?
  triggerType       String             @default("MANUAL")
  platform          String
  framework         String
  environment       String             @default("staging")
  branch            String?            @default("main")
  commitSha         String?
  status            String             @default("PENDING")
  startTime         DateTime?
  endTime           DateTime?
  duration          Int?
  totalTests        Int                @default(0)
  passedTests       Int                @default(0)
  failedTests       Int                @default(0)
  skippedTests      Int                @default(0)
  consoleLogUrl     String?
  allureReportUrl   String?
  errorDetails      String?
  triggeredBy       String?
  emailRecipients   String?
  androidDeviceType String?
  emulatorName      String?
  webTags           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  module            AutomationModule   @relation(fields: [moduleId], references: [id])
  testResults       TestResult[]
  artifacts         ExecutionArtifact[]
}

model TestResult {
  id          String    @id @default(cuid())
  executionId String
  name        String
  suite       String?
  status      String    @default("PENDING")
  duration    Int?
  error       String?
  stackTrace  String?
  screenshotPath String?
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model ExecutionArtifact {
  id          String    @id @default(cuid())
  executionId String
  name        String
  type        String
  url         String
  size        Int?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model Schedule {
  id            String           @id @default(cuid())
  moduleId      String
  name          String
  cronExpr      String
  testCommand   String?
  branch        String?          @default("main")
  androidDeviceType String?
  emulatorName  String?
  webTags       String?
  emailRecipients String?
  isActive      Boolean          @default(true)
  isPaused      Boolean          @default(false)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  module        AutomationModule @relation(fields: [moduleId], references: [id])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  source          String
  eventType       String
  deliveryId      String?  @unique
  repoFullName    String?
  branch          String?
  commitSha       String?
  pusherName      String?
  changedFiles    String?
  payload         String
  executionId     String?
  processed       Boolean  @default(false)
  signature       String?
  createdAt       DateTime @default(now())
}

model JenkinsJob {
  id          String   @id @default(cuid())
  name        String   @unique
  url         String?
  description String?
  parameters  String?
  lastBuildNumber Int?
  lastBuildStatus String?
  syncedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GitRepository {
  id              String   @id @default(cuid())
  fullName        String   @unique
  defaultBranch   String?
  branches        String?
  lastCommitSha   String?
  lastCommitMsg   String?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
