# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/saral_qa?schema=public"

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your_very_secure_jwt_secret_change_this_in_production

# Jenkins Integration
JENKINS_URL=http://your-jenkins-server:8080
JENKINS_USER=your-jenkins-username
JENKINS_TOKEN=your-jenkins-api-token
JENKINS_JOB_NAME=event-module-automation

# GitHub Integration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-org
GITHUB_REPO_NAME=saral-automation
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Firebase (optional for mobile)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY={}

# App Settings
NODE_ENV=development
